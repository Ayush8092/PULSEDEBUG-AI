# PulseDebug AI — .gitignore
# File: .gitignore (repo root)
# Purpose: Prevents build artifacts, secrets, and local state from being committed.

# ---- Secrets (NEVER commit these) ----
.env
.env.local
.env.*.local
*.env
.env.example
.env.local.example
npm-cache/

# ---- Python ----
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
env/
venv/
.venv/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.pyc

# ---- SQLite database (ephemeral in demo) ----
backend/data/*.db
backend/data/*.db-shm
backend/data/*.db-wal

# ---- Node / Next.js ----
node_modules/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp/
.pnp.js

# ---- OS ----
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/settings.json

# ---- Vercel ----
.vercel